    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lines.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lengths.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lines.Array.data[0]
      value: Oh no!
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lines.Array.data[1]
      value: You found me!
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lines.Array.data[2]
      value: But I'll tell you something...
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lines.Array.data[3]
      value: Do you remember Sam?
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lines.Array.data[4]
      value: He was always so scared...
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lines.Array.data[5]
      value: And then one day he disappeared...
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lines.Array.data[6]
      value: But you can find him again!
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lines.Array.data[7]
      value: In the bottom left of the cafeteria!
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lines.Array.data[8]
      value: Tee-hee!
      objectReference: {fileID: 0}
    - target: {fileID: 5754732214930879054, guid: b507de35029c3dc469db7fb403b3d94a, type: 3}
      propertyPath: lengths.Array.data[0]
